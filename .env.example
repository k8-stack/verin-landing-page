# Copy to .env.local and fill in. All values are public (bundled into the site).

# Absolute site origin, used for social-share image URLs. e.g. https://verin.example
VITE_SITE_URL=

# HTTPS endpoint that accepts inquiry JSON via POST and returns 2xx on success.
# Leave empty and the contact form will say plainly that nothing was sent.
VITE_INQUIRY_ENDPOINT=

# Public inbox shown as an alternative contact route. Leave empty to hide.
VITE_CONTACT_EMAIL=
